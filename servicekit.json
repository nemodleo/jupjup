{
  "_": "servicekit(~/.claude/skills/servicekit) 설정. 사이트 쪽은 nemodleo/jupjup-web 의 servicekit.json",
  "name": {
    "ko": "줍줍",
    "en": "Jupjup"
  },
  "site": "https://jupjup.d-t-it.com/",
  "contact": "file:CONTACT",
  "langs": [
    "ko",
    "en"
  ],
  "modules": {
    "contact": {
      "file": "CONTACT",
      "set": "make contact EMAIL=…"
    },
    "release": {
      "site_repo": "nemodleo/jupjup-web",
      "notes": "docs/releases/<버전>.md",
      "client": "Sources/Update.swift"
    },
    "privacy": {
      "file": "PRIVACY.md",
      "sections": [
        "local-history",
        "update-check",
        "reports"
      ]
    },
    "analytics": {
      "file": "Sources/Reporting.swift",
      "sentry": true,
      "telemetrydeck": true,
      "default_on": true
    },
    "design": {
      "canvas": "https://claude.ai/artifact/Gj9b2oJqebV8b7GgpkGJ3o",
      "tool": "claude.ai 디자인 캔버스(Easel 아님)",
      "current": "1번 보드 '지금 버전'(Current.dc.html)",
      "snapshot": "Jupjup -snapshot <폴더> [-lang en] 로 앱 화면 그림"
    },
    "mac-build": {
      "build": "make build (build.sh)",
      "cert": "make cert (Jupjup Dev)",
      "dmg": "make dmg"
    },
    "mail": {
      "where": "사이트 저장소 nemodleo/jupjup-web 의 email/(brand.json·samples.json)"
    }
  }
}
